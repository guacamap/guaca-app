# GUACA production tier — copy to infra/env/prod.env ON THE VM and fill in.
# Filled files are gitignored; never commit secrets.
# Generate secrets with: openssl rand -hex 32

# --- identity of this tier (leave as-is for prod) ---
API_HOST_PORT=3001
EDGE_ALIAS=guaca-prod-api

# --- CORS: comma-separated browser origins allowed to call the API ---
WEB_ORIGIN=https://app.guaca.live,https://guaca.live

# --- secrets (required — compose fails fast if POSTGRES_PASSWORD is empty) ---
POSTGRES_USER=guaca
POSTGRES_PASSWORD=
SESSION_SECRET=
OPERATOR_TOKEN=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=guaca-photos

# --- inference (§7.9): one OpenAI-compatible endpoint; swap = change base URL ---
# Primary: Nebius (Qwen3-VL — text + vision on one provider)
# Failover: INFERENCE_BASE_URL=https://api.minimax.io/v1  INFERENCE_MODEL=MiniMax-M3
INFERENCE_BASE_URL=https://api.studio.nebius.com/v1
INFERENCE_API_KEY=
INFERENCE_MODEL=Qwen/Qwen3-VL-8B-Instruct
INFERENCE_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# --- email login codes (blank = codes print to the API log) ---
RESEND_API_KEY=
EMAIL_FROM=Guaca <login@guaca.live>
