# GUACA production tier — copy to infra/env/prod.env ON THE VM and fill in.
# Filled files are gitignored; never commit secrets.
# Generate secrets with: openssl rand -hex 32
# Every var marked (required) is guarded with :? in compose — the deploy
# refuses to start if one is empty, so fill them all.

# --- identity of this tier (required; leave values as-is for prod) ---
API_HOST_PORT=3001
EDGE_ALIAS=guaca-prod-api

# --- CORS: comma-separated browser origins, scheme included, no trailing slash ---
WEB_ORIGIN=https://app.guaca.live,https://guaca.live

# --- secrets (required) ---
POSTGRES_USER=guaca
POSTGRES_PASSWORD=
SESSION_SECRET=
OPERATOR_TOKEN=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=guaca-photos

# --- inference (§7.9): one OpenAI-compatible endpoint; swap = change base URL ---
# Primary: Nebius Token Factory (hosted — Qwen text + Qwen VL vision, verified 2026-08-15)
# Failover: INFERENCE_BASE_URL=https://api.minimax.io/v1  INFERENCE_MODEL=MiniMax-M3
# Self-hosted alternative: vLLM + Qwen/Qwen3-VL-8B-Instruct (docs/DEPLOY.md)
INFERENCE_BASE_URL=https://api.tokenfactory.nebius.com/v1
INFERENCE_API_KEY=
INFERENCE_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
INFERENCE_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# --- email login codes ---
# Blank = codes print to the API log, which locks out real tourists.
# REQUIRED before prod has real users: Resend API key + verified guaca.live domain.
RESEND_API_KEY=
EMAIL_FROM="Guaca <login@guaca.live>"

# --- store review (Play/App Store reviewers cannot receive email codes) ---
# Leave blank to disable entirely. When set, this ONE address always gets
# this exact code, through the normal hash/expiry/single-use path.
REVIEW_EMAIL=
REVIEW_CODE=
# The Play reviewer's spotter login. Must also exist on the roster (guaca spotter add ... --email).
REVIEW_SPOTTER_EMAIL=
