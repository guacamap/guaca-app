# GUACA staging tier — copy to infra/env/staging.env ON THE VM and fill in.
# Same VM as prod, separate compose project + volumes (§4.3). Use DIFFERENT
# secrets from prod so a leaked staging value never opens production.
# All blank vars below are required (compose :? guards refuse empty values).

# --- identity of this tier (required; leave values as-is for staging) ---
API_HOST_PORT=3101
EDGE_ALIAS=guaca-staging-api

# --- CORS ---
WEB_ORIGIN=https://staging.app.guaca.live,https://staging.guaca.live,http://localhost:3002

# --- secrets (required — different from prod) ---
POSTGRES_USER=guaca
POSTGRES_PASSWORD=
SESSION_SECRET=
OPERATOR_TOKEN=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=guaca-photos

# --- inference: staging shares the prod endpoint — never a second GPU (§4.3) ---
INFERENCE_BASE_URL=https://api.tokenfactory.nebius.com/v1
INFERENCE_API_KEY=
INFERENCE_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
INFERENCE_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# --- email codes stay in the log on staging (leave blank) ---
RESEND_API_KEY=
EMAIL_FROM=
