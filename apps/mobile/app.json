{
  "expo": {
    "name": "Guaca",
    "slug": "guaca",
    "scheme": "guaca",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D8B8B"
    },
    "android": {
      "package": "live.guaca.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D8B8B"
      },
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "bundleIdentifier": "live.guaca.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Spotters photograph places to verify them on the map.",
        "NSLocationWhenInUseUsageDescription": "Guaca shows verified places near you and confirms Spotter submissions happen on-site."
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
