{
  "name": "@guaca/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "build": "tsc -b",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/websocket": "^11.3.0",
    "@guaca/agents": "workspace:*",
    "@guaca/db": "workspace:*",
    "@guaca/shared": "workspace:*",
    "fastify": "^5.1.0",
    "fastify-plugin": "^6.0.0",
    "jose": "^6.2.8",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^3.25.76"
  }
}
