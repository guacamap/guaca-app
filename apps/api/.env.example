# Local dev secrets — copy to apps/api/.env (gitignored).
# `pnpm dev` loads this via node's --env-file-if-exists; nothing else reads it.
# For the CLI (guaca audit/verify), source it first:  set -a; . apps/api/.env; set +a

# Inference — one OpenAI-compatible endpoint (§7.9).
# Primary: Nebius Token Factory (Qwen text + vision on one provider).
#   List models with your key:  curl -s https://api.tokenfactory.nebius.com/v1/models -H "Authorization: Bearer $KEY"
# Failover: MiniMax —  INFERENCE_BASE_URL=https://api.minimax.io/v1  INFERENCE_MODEL=MiniMax-M3
INFERENCE_BASE_URL=https://api.tokenfactory.nebius.com/v1
INFERENCE_API_KEY=
INFERENCE_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
INFERENCE_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# Email login codes — leave blank in dev (codes print to the API log).
RESEND_API_KEY=
EMAIL_FROM=
# One sender per purpose (all must be on the Resend-verified domain).
# login@ carries codes only; hola@ carries anything a person might answer
# and is the address printed on the site. EMAIL_FROM is the fallback for both.
EMAIL_FROM_LOGIN=Guaca <login@guaca.live>
EMAIL_FROM_HELLO=Guaca <hola@guaca.live>
EMAIL_REPLY_TO=hola@guaca.live
# Uptime alerts (infra/monitor.sh) come from their own address.
ALERT_FROM=Guaca Alerts <alerts@guaca.live>

# Trend engine weather modulation — Open-Meteo is free and keyless; a down
# provider degrades to weather-free trend scores, never a failed request.
WEATHER_ENABLED=true
WEATHER_BASE_URL=https://api.open-meteo.com
