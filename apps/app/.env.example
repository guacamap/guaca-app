# Product app (app.guaca.live). Copy to .env.local for dev.
#
# REQUIRED. Where /api/* is proxied by next.config.mjs rewrites — every API
# call in this app is relative, so if this is wrong in production the app
# proxies to localhost and nothing works. Rewrites are baked at BUILD time,
# so on Vercel this must be a build-time variable. Dev default:
# http://localhost:3001
API_PROXY_TARGET=https://api.guaca.live

# REQUIRED. Without it the map renders nothing (no error).
# guaca-dev locally; guaca-web-prod (URL-restricted) in production.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Where the marketing site lives — privacy, terms and delete-account links.
NEXT_PUBLIC_LANDING_URL=https://guaca.live
# This app's own public origin — used in WhatsApp shares.
NEXT_PUBLIC_APP_URL=https://app.guaca.live
# Base URL printed into villa QR cards.
NEXT_PUBLIC_QR_BASE_URL=https://app.guaca.live
# Optional: operator WhatsApp number, digits only. Hides the row if unset.
NEXT_PUBLIC_OPERATOR_WHATSAPP=
