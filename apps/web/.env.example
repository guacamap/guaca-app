# Marketing site (guaca.live). Copy to .env.local for dev.
#
# Where /api/* is proxied by next.config.mjs rewrites. Rewrites are baked at
# BUILD time, so on Vercel this must be a build-time variable.
# Dev default is http://localhost:3001.
API_PROXY_TARGET=https://api.guaca.live
# Mapbox public token (guaca-dev locally; guaca-web-prod, URL-restricted, in prod)
NEXT_PUBLIC_MAPBOX_TOKEN=
