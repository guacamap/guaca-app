# Leave empty in dev: relative /api/* is proxied to the Fastify API by
# next.config.mjs rewrites (API_PROXY_TARGET, default http://localhost:3001).
# In prod set the real API origin, e.g. https://api.guaca.live
NEXT_PUBLIC_API_URL=
# Mapbox public token (guaca-dev locally; guaca-web-prod, URL-restricted, in prod)
NEXT_PUBLIC_MAPBOX_TOKEN=
